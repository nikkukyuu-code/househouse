{
  "name": "house-ranking",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    { "binding": "DB", "database_name": "stb-ranking", "database_id": "ecdbefd9-bbdf-422b-be2a-285825c8db1a" }
  ],
  "env": {
    "test": {
      "name": "house-ranking-test",
      "vars": { "TEST_TIME_OVERRIDE": "1" },
      "d1_databases": [
        { "binding": "DB", "database_name": "house-ranking-test", "database_id": "c95aeabd-c5cf-44fa-800d-efda67ca7d25" }
      ]
    }
  }
}
